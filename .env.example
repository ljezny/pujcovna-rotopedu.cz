# =========================================================
# PŮJČOVNA ROTOPEDŮ — environment variables
# Lokálně: zkopíruj jako `.env`. Na Vercelu: Project → Settings → Environment Variables.
# =========================================================

# Port lokálního dev serveru
PORT=3000

# Kam chodí poptávky
ORDER_EMAIL=rezervace@pujcovna-rotopedu.cz

# Odesílatel (většinou shodný se SMTP_USER)
SMTP_FROM=rezervace@pujcovna-rotopedu.cz

# SMTP (bez SMTP_HOST se e-maily jen logují do konzole)
SMTP_HOST=mail.wp-hosting.eu
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=rezervace@pujcovna-rotopedu.cz
SMTP_PASS=your-smtp-password
# SMTP_TLS_REJECT_UNAUTHORIZED=false
